ARG JDK_BASE_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
FROM ${JDK_BASE_IMAGE}
USER root
RUN printf '%s\n' \
      'deb https://mirrors.tuna.tsinghua.edu.cn/ubuntu/ jammy main universe' \
      'deb https://mirrors.tuna.tsinghua.edu.cn/ubuntu/ jammy-updates main universe' \
      'deb https://mirrors.tuna.tsinghua.edu.cn/ubuntu/ jammy-security main universe' > /tmp/jmeter-ubuntu.list \
    && printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod +x /usr/sbin/policy-rc.d \
    && apt-get -o Dir::Etc::sourcelist=/tmp/jmeter-ubuntu.list -o Dir::Etc::sourceparts=- -o Acquire::Retries=3 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Dir::Etc::sourcelist=/tmp/jmeter-ubuntu.list -o Dir::Etc::sourceparts=- install -y --no-install-recommends ca-certificates tar xz-utils \
    && rm -rf /var/lib/apt/lists/* /tmp/jmeter-ubuntu.list \
    && groupadd --gid 10001 jmeter-manager \
    && useradd --uid 10001 --gid 10001 --create-home jmeter-manager
