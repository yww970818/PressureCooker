COMPOSE_PROJECT_NAME=pressurecooker
JMETER_UID=1000
JMETER_GID=1000
JMETER_IMAGE=pressurecooker-platform:local
JMETER_MANAGER_IMAGE=pressurecooker-manager:local
JMETER_MANAGER_BASE_IMAGE=pressurecooker-control-base:local
MINIO_IMAGE=pressurecooker-minio:2025-10-15
JDK_BASE_IMAGE=mcr.microsoft.com/openjdk/jdk:21-ubuntu
JMETER_BIND_ADDRESS=0.0.0.0
JMETER_API_PORT=18090
JMETER_MCP_BIND_ADDRESS=0.0.0.0
JMETER_MCP_PORT=18091
JMETER_MCP_PUBLIC_URL=http://localhost:18091/mcp
# Workflow authoring limits; other API request bodies remain 6 MiB.
JMETER_WORKFLOW_MAX_NODES=5000
JMETER_WORKFLOW_MAX_EDGES=10000
JMETER_WORKFLOW_BODY_MIB=32
JMETER_REDIS_ADDR=host.docker.internal:6379
JMETER_MYSQL_HOST=host.docker.internal
JMETER_MYSQL_PORT=3306
JMETER_MYSQL_DATABASE=jmeter
JMETER_MYSQL_USER=jmeter
MINIO_BIND_ADDRESS=0.0.0.0
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
# Set after an HTTPS reverse proxy/domain is ready; plain port-forwarding can leave empty.
MINIO_BROWSER_REDIRECT_URL=

# Size generator memory for the selected plan, concurrency and response bodies.
JMETER_WORKER_MEMORY_LIMIT=6g

# Core registers after connecting Redis, then reports all worker observations.
PRESSURECOOKER_MANAGER_URL=http://manager:8080
# Compose 集群成员通过“集群管理”保存；标准两 Core 六 worker 初始分为 2/4。
